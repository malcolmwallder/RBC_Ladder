{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rbc-ladder",
  "compatibility_date": "2026-08-03",
  "main": "./worker/index.js",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "STORAGE",
      "id": "57f3d27f2e914622a9219a0b2608c930"
    }
  ],
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
